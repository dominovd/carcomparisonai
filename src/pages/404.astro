---
import Base from "@/layouts/Base.astro";
---

<Base
  title="Page not found"
  description="The page you are looking for does not exist."
  robots="noindex,follow"
>
  <div class="mx-auto flex max-w-3xl flex-col items-center px-4 py-24 text-center">
    <p class="text-sm font-semibold uppercase tracking-wide text-brand">404</p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight">Page not found</h1>
    <p class="mt-3 text-ink-soft">
      The page you are looking for does not exist or has moved.
    </p>
    <a
      href="/"
      class="mt-6 rounded-lg bg-brand px-5 py-3 text-sm font-semibold text-white transition hover:bg-brand-dark"
    >
      Back to the homepage
    </a>
  </div>
</Base>
